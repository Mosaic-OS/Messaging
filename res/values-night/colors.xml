<resources>
    <!--
        Conversation-list snippet colors are resolved in code (ConversationListItemView),
        so they can't use a theme attribute. With the Material 3 day/night theme (no more
        force-dark), their hardcoded dark day values would be dark-on-dark here, so override
        them with light tones for night. Read (secondary) stays dimmer than unread (primary).
    -->
    <color name="conversation_list_item_read">@android:color/system_neutral1_300</color>
    <color name="conversation_list_item_unread">@android:color/system_neutral1_50</color>

    <!--
        Contact picker is now an adaptive M3 surface (no longer hardcoded white), so its
        panel goes dark here and its hardcoded list text / divider need light night values.
    -->
    <color name="contact_picker_background">@android:color/system_neutral1_900</color>
    <color name="contact_list_text_primary">@android:color/system_neutral1_50</color>
    <color name="contact_list_text_secondary">@android:color/system_neutral1_300</color>
    <color name="compose_contact_divider">#44FFFFFF</color>
</resources>
